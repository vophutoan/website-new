---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

// Nhận dữ liệu từ các file Markdown (nếu có)
const { frontmatter } = Astro.props;
const title = frontmatter?.title || Astro.props.title || "Võ Phú Toàn";
const date = frontmatter?.date;
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Website cá nhân</title>
  </head>
  <body>
    <!-- Header luôn hiển thị -->
    <Header />

    <!-- Khung chứa nội dung chính và Sidebar chia làm 2 cột -->
    <div class="main-wrapper">
      <main>
        <!-- Tự động chèn Tiêu đề và Ngày tháng nếu đây là một trang bài viết -->
        {frontmatter && <h1 class="post-title">{title}</h1>}
        {date && <p class="post-meta">🗓️ Đăng ngày: {date}</p>}
        
        <!-- Nội dung file Markdown hoặc trang sẽ được đẩy vào đây -->
        <slot />
      </main>

      <!-- Sidebar bên phải -->
      <Sidebar />
    </div>

    <!-- Footer luôn hiển thị -->
    <Footer />
  </body>
</html>